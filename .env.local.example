# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (the account connected to your Flodesk Checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Comma-separated Stripe price IDs that count as membership access.
# Leave blank to treat every subscription as membership.
MEMBER_PRICE_IDS=

# Mux signing key (System Settings → Signing Keys) — separate from any key
# used by the honeytrucker landing-page repo.
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# Where Flodesk Checkout sends buyers to purchase membership.
NEXT_PUBLIC_FLODESK_CHECKOUT_URL=

# This app's own deployed URL (used for Stripe billing-portal return_url etc).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
